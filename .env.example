# ระบบหลัก
DATABASE_URL=
AUTH_SECRET=
CRON_SECRET=

# เข้ารหัสฟิลด์อ่อนไหว (เลขบัตรประชาชนในใบสมัครงาน) — สร้างด้วย: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# เก็บรูปถ่าย/เอกสารแนบใบสมัครงาน (Cloudinary, authenticated delivery)
# ไม่มีค่า = ใช้ driver "db" (เก็บลง Postgres) แทน ใช้สำหรับ dev เท่านั้น
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ตั้งค่าเฉพาะถ้า Cloudinary plan เปิด "Token-based authentication" แล้ว (ไม่มีในแพลนปัจจุบัน)
# ถ้าไม่ตั้ง ระบบยังปลอดภัยด้วย sign_url (ไม่ expire แต่ปลอมไม่ได้ + เข้าถึงได้เฉพาะผ่าน route ที่ auth แล้ว)
CLOUDINARY_AUTH_TOKEN_KEY=

# ส่งรายงานเข้า Discord
DISCORD_ATTENDANCE_WEBHOOK_URL=
# ตั้งแยกตามสาขาได้ เช่น DISCORD_ATTENDANCE_WEBHOOK_URL_WKO=

# รับ Slash Command จาก Discord
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_ROLE_IDS=

# กติกาการแจ้งเตือน
ATTENDANCE_ALERT_GRACE_MINUTES=15
ATTENDANCE_DAILY_REPORT_TIME=23:30
