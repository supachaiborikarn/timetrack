generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             String                           @id @default(cuid())
  employeeId                     String                           @unique
  username                       String?                          @unique
  name                           String
  email                          String?                          @unique
  phone                          String?                          @unique
  pin                            String
  password                       String?
  role                           Role                             @default(EMPLOYEE)
  stationId                      String?
  departmentId                   String?
  deviceId                       String?
  deviceFingerprint              String?
  photoUrl                       String?
  hourlyRate                     Decimal                          @default(0)
  dailyRate                      Decimal                          @default(0)
  baseSalary                     Decimal                          @default(0)
  otherExpenses                  Decimal                          @default(0)
  otRateMultiplier               Decimal                          @default(1.5)
  isActive                       Boolean                          @default(true)
  failedLoginAttempts            Int                              @default(0)
  failedLoginFirstAt             DateTime?
  loginLockedUntil               DateTime?
  employeeStatus                 EmployeeStatus                   @default(ACTIVE)
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt
  address                        String?
  bankAccountNumber              String?
  bankName                       String?
  birthDate                      DateTime?
  citizenId                      String?
  emergencyContactName           String?
  emergencyContactPhone          String?
  emergencyContactRelation       String?
  gender                         String?
  isSocialSecurityRegistered     Boolean                          @default(false)
  nickName                       String?
  probationEndDate               DateTime?
  // Daily rate paid on/before probationEndDate. Null = no separate probation rate,
  // so payroll uses dailyRate for every day exactly as it did before this field existed.
  probationDailyRate             Decimal?
  housingStatus                  HousingStatus                    @default(UNKNOWN)
  dormitoryId                    String?
  /// ค่าที่พักรายเดือนเฉพาะคนนี้ — null = ใช้ค่าเริ่มต้นของบริษัท
  housingAllowance               Decimal?
  housingNote                    String?
  housingUpdatedAt               DateTime?
  /// ใครเป็นคนบันทึกล่าสุด — ถ้าเท่ากับตัวพนักงานเองแปลว่าเจ้าตัวแจ้งมา
  /// ซึ่งคนกดจ่ายค่าที่พักควรเห็น เพราะเป็นข้อมูลที่ผู้รับเงินกรอกเอง
  housingUpdatedById             String?
  registeredStationId            String?
  socialSecurityNumber           String?
  startDate                      DateTime?                        @default(now())
  advances                       Advance[]
  announcements                  Announcement[]
  approvedAttendances            Attendance[]                     @relation("AttendanceApprover")
  attendances                    Attendance[]
  auditLogs                      AuditLog[]
  authenticators                 Authenticator[]
  comments                       Comment[]
  dailyPayrollOverrides          DailyPayrollOverride[]
  approvedLeaves                 Leave[]                          @relation("LeaveApprover")
  leaves                         Leave[]
  notifications                  Notification[]
  overtimeRequests               OvertimeRequest[]                @relation("OvertimeRequests")
  payrollRecords                 PayrollRecord[]
  profileEditRequests            ProfileEditRequest[]
  pushSubscriptions              PushSubscription[]
  reviewSubmissions              ReviewSubmission[]
  shiftAssignments               ShiftAssignment[]
  swapRequestsSent               ShiftSwap[]                      @relation("SwapRequester")
  swapRequestsReceived           ShiftSwap[]                      @relation("SwapTarget")
  specialIncomes                 SpecialIncome[]
  stationTransfers               StationTransfer[]
  timeCorrections                TimeCorrection[]
  department                     Department?                      @relation(fields: [departmentId], references: [id])
  registeredStation              Station?                         @relation("RegisteredStation", fields: [registeredStationId], references: [id])
  station                        Station?                         @relation("WorkStation", fields: [stationId], references: [id])
  happinessLogs                  HappinessLog[]
  oneOnOneLogs                   OneOnOneLog[]                    @relation("OneOnOneUser")
  supervisedOneOnOneLogs         OneOnOneLog[]                    @relation("OneOnOneSupervisor")
  reviewedApplications           JobApplication[]                 @relation("ApplicationReviewer")
  createdJobOpenings             JobOpening[]                     @relation("JobOpeningCreator")
  hiredFromApplication           JobApplication?                  @relation("ApplicationHire")
  ownedAssets                    StoredAsset[]                    @relation("AssetOwner")
  uploadedAssets                 StoredAsset[]                    @relation("AssetUploader")
  dormitory                      Dormitory?                       @relation("EmployeeDormitory", fields: [dormitoryId], references: [id], onDelete: SetNull)
  housingUpdatedBy               User?                            @relation("HousingUpdatedBy", fields: [housingUpdatedById], references: [id], onDelete: SetNull)
  housingUpdatesMade             User[]                           @relation("HousingUpdatedBy")
  feedbackQrs                    CustomerFeedbackQr[]             @relation("FeedbackQrEmployee")
  feedbackQrsCreated             CustomerFeedbackQr[]             @relation("FeedbackQrCreatedBy")
  feedbackQrsApproved            CustomerFeedbackQr[]             @relation("FeedbackQrApprovedBy")
  feedbackQrsPrinted             CustomerFeedbackQr[]             @relation("FeedbackQrLastPrintedBy")
  feedbackResponses              CustomerFeedbackResponse[]       @relation("FeedbackResponseEmployee")
  feedbackCasesAssigned          CustomerFeedbackCase[]           @relation("FeedbackCaseAssignee")
  feedbackReviewSnapshots        CustomerFeedbackReviewSnapshot[] @relation("ReviewSnapshotEmployee")
  feedbackReviewSnapshotsMade    CustomerFeedbackReviewSnapshot[] @relation("ReviewSnapshotGeneratedBy")
  feedbackReviewRequests         CustomerFeedbackReviewRequest[]  @relation("ReviewRequestEmployee")
  feedbackReviewRequestsReviewed CustomerFeedbackReviewRequest[]  @relation("ReviewRequestReviewedBy")
  feedbackPeriodsClosed          ReviewPeriod[]                   @relation("ReviewPeriodClosedBy")

  @@index([stationId])
  @@index([departmentId])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Announcement {
  id                  String             @id @default(cuid())
  title               String
  content             String
  authorId            String
  isActive            Boolean            @default(true)
  isPinned            Boolean            @default(false)
  targetDepartmentIds String?
  imageAssetId        String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  author              User               @relation(fields: [authorId], references: [id])
  image               StoredAsset?       @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  comments            Comment[]
  reads               AnnouncementRead[]

  @@index([createdAt])
  @@index([isPinned])
}

model Comment {
  id        String       @id @default(cuid())
  content   String
  postId    String
  authorId  String
  createdAt DateTime     @default(now())
  author    User         @relation(fields: [authorId], references: [id])
  post      Announcement @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
}

model ReviewPeriod {
  id                String                           @id @default(cuid())
  title             String
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean                          @default(true)
  closedAt          DateTime?
  closedById        String?
  closedBy          User?                            @relation("ReviewPeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt
  submissions       ReviewSubmission[]
  feedbackSnapshots CustomerFeedbackReviewSnapshot[]
}

model ReviewSubmission {
  id            String       @id @default(cuid())
  employeeId    String
  periodId      String
  selfReview    String
  managerReview String?
  rating        Int?
  status        String       @default("DRAFT")
  submittedAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  employee      User         @relation(fields: [employeeId], references: [id])
  period        ReviewPeriod @relation(fields: [periodId], references: [id])

  @@unique([employeeId, periodId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ShiftTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  shifts      Json
  stationId   String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([stationId])
}

model LeaveBalance {
  id            String   @id @default(cuid())
  userId        String
  year          Int
  sickLeave     Int      @default(30)
  annualLeave   Int      @default(6)
  personalLeave Int      @default(3)
  usedSick      Int      @default(0)
  usedAnnual    Int      @default(0)
  usedPersonal  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, year])
  @@index([userId])
}

model OvertimeRequest {
  id           String    @id @default(cuid())
  userId       String
  date         DateTime
  hours        Decimal
  reason       String
  status       String    @default("PENDING")
  approvedById String?
  approvedAt   DateTime?
  rejectReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation("OvertimeRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Station {
  id                   String                     @id @default(cuid())
  name                 String
  code                 String                     @unique
  type                 StationType
  address              String
  latitude             Decimal
  longitude            Decimal
  radius               Int                        @default(100)
  wifiSSID             String?
  qrCode               String?
  isActive             Boolean                    @default(true)
  /// หมายเลขฉุกเฉินที่เปิดเผยต่อสาธารณะบนหน้าแจ้งเหตุเร่งด่วนของ customer feedback
  /// ห้ามนำ emergencyContactPhone ของพนักงานมาใช้แทน
  publicEmergencyPhone String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  feedbackQrs          CustomerFeedbackQr[]
  feedbackResponses    CustomerFeedbackResponse[] @relation("FeedbackStationResponse")
  departments          Department[]
  shifts               Shift[]
  registeredEmployees  User[]                     @relation("RegisteredStation")
  employees            User[]                     @relation("WorkStation")
  attendances          Attendance[]               @relation("AttendanceCheckInStation")
  checkOutAttendances  Attendance[]               @relation("AttendanceCheckOutStation")
  transfersFrom        StationTransfer[]          @relation("TransferFrom")
  transfersTo          StationTransfer[]          @relation("TransferTo")
  jobApplications      JobApplication[]
  jobOpenings          JobOpening[]
  dormitories          Dormitory[]

  @@index([code])
}

model Department {
  id              String            @id @default(cuid())
  name            String
  code            String
  stationId       String
  isFrontYard     Boolean           @default(false)
  weeklyDayOff    Int?
  sundayEndTime   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  station         Station           @relation(fields: [stationId], references: [id])
  allowedShifts   DepartmentShift[]
  employees       User[]
  jobApplications JobApplication[]
  jobOpenings     JobOpening[]

  @@unique([stationId, code])
  @@index([stationId])
}

model Shift {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  startTime    String
  endTime      String
  stationId    String?
  breakMinutes Int               @default(60)
  isNightShift Boolean           @default(false)
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  departments  DepartmentShift[]
  station      Station?          @relation(fields: [stationId], references: [id])
  assignments  ShiftAssignment[]

  @@index([stationId])
  @@index([code])
}

model DepartmentShift {
  id           String     @id @default(cuid())
  departmentId String
  shiftId      String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  shift        Shift      @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([departmentId, shiftId])
}

model ShiftPattern {
  id           String   @id @default(cuid())
  name         String
  departmentId String?
  month        Int
  year         Int
  isActive     Boolean  @default(true)
  patternData  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([departmentId, month, year])
}

model ShiftAssignment {
  id        String   @id @default(cuid())
  userId    String
  shiftId   String
  date      DateTime
  isDayOff  Boolean  @default(false)
  createdAt DateTime @default(now())
  shift     Shift    @relation(fields: [shiftId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([shiftId])
}

model Attendance {
  id                 String            @id @default(cuid())
  userId             String
  date               DateTime
  checkInTime        DateTime?
  checkInLat         Decimal?
  checkInLng         Decimal?
  checkInDeviceId    String?
  checkInMethod      String?
  checkInStationId   String?
  checkInStation     Station?          @relation("AttendanceCheckInStation", fields: [checkInStationId], references: [id])
  checkOutTime       DateTime?
  checkOutLat        Decimal?
  checkOutLng        Decimal?
  checkOutDeviceId   String?
  checkOutMethod     String?
  checkOutStationId  String?
  checkOutStation    Station?          @relation("AttendanceCheckOutStation", fields: [checkOutStationId], references: [id])
  status             AttendanceStatus  @default(PENDING)
  actualHours        Decimal?
  overtimeHours      Decimal?
  lateMinutes        Int?
  earlyLeaveMinutes  Int?
  latePenaltyAmount  Decimal           @default(0)
  note               String?
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  breakDurationMin   Int?
  breakEndTime       DateTime?
  breakPenaltyAmount Decimal           @default(0)
  breakStartTime     DateTime?
  approver           User?             @relation("AttendanceApprover", fields: [approvedBy], references: [id])
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transfers          StationTransfer[]

  @@unique([userId, date])
  @@index([date])
  @@index([status])
}

model Leave {
  id         String      @id @default(cuid())
  userId     String
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  approver   User?       @relation("LeaveApprover", fields: [approvedBy], references: [id])
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@index([status])
}

model PayrollPeriod {
  id        String          @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  payDate   DateTime
  status    PayrollStatus   @default(DRAFT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  records   PayrollRecord[]

  @@unique([startDate, endDate])
}

model PayrollRecord {
  id                String        @id @default(cuid())
  periodId          String
  userId            String
  workDays          Decimal
  totalHours        Decimal
  overtimeHours     Decimal
  dailyRate         Decimal       @default(0)
  basePay           Decimal
  overtimePay       Decimal
  latePenalty       Decimal       @default(0)
  advanceDeduct     Decimal       @default(0)
  otherDeduct       Decimal       @default(0)
  socialSecurity    Decimal       @default(0)
  adjustment        Decimal       @default(0)
  specialIncome     Decimal       @default(0)
  netPay            Decimal
  employeeName      String?
  employeeCode      String?
  stationName       String?
  departmentName    String?
  bankName          String?
  bankAccountNumber String?
  documentNumber    String?       @unique
  receiptNumber     String?       @unique
  paymentStatus     String        @default("PENDING")
  paymentMethod     String        @default("BANK_TRANSFER")
  paidAt            DateTime?
  paymentReference  String?
  paymentNote       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  period            PayrollPeriod @relation(fields: [periodId], references: [id])
  user              User          @relation(fields: [userId], references: [id])

  @@unique([periodId, userId])
  @@index([userId])
  @@index([paymentStatus])
}

model Advance {
  id           String        @id @default(cuid())
  userId       String
  amount       Decimal
  date         DateTime
  reason       String?
  status       AdvanceStatus @default(PENDING)
  approvedBy   String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  month        Int?
  note         String?
  year         Int?
  attachmentId String?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachment   StoredAsset?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([status])
  @@index([month, year])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimeCorrection {
  id               String        @id @default(cuid())
  userId           String
  date             DateTime
  requestType      String
  requestedTime    DateTime
  reason           String
  originalCheckIn  DateTime?
  originalCheckOut DateTime?
  status           RequestStatus @default(PENDING)
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  attachmentId     String?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachment       StoredAsset?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([status])
}

model ShiftSwap {
  id             String        @id @default(cuid())
  requesterId    String
  targetId       String
  requesterDate  DateTime
  targetDate     DateTime
  reason         String?
  status         RequestStatus @default(PENDING)
  targetAccepted Boolean       @default(false)
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  requester      User          @relation("SwapRequester", fields: [requesterId], references: [id])
  target         User          @relation("SwapTarget", fields: [targetId], references: [id])

  @@index([requesterId])
  @@index([targetId])
  @@index([status])
}

model ShiftPool {
  id          String          @id @default(cuid())
  shiftId     String
  date        DateTime
  releasedBy  String
  claimedBy   String?
  reason      String?
  status      ShiftPoolStatus @default(OPEN)
  bonusAmount Decimal?
  claimedAt   DateTime?
  expiredAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([date])
  @@index([releasedBy])
}

model EmployeeAvailability {
  id        String             @id @default(cuid())
  userId    String
  date      DateTime
  status    AvailabilityStatus @default(AVAILABLE)
  note      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  group           String
  description     String?
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([group])
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

model ProfileEditRequest {
  id           String    @id @default(cuid())
  userId       String
  fieldName    String
  fieldLabel   String
  oldValue     String?
  newValue     String
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?
  rejectReason String?
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model DailyPayrollOverride {
  id                  String   @id @default(cuid())
  userId              String
  date                DateTime
  overrideDailyWage   Decimal?
  overrideOT          Decimal?
  overrideLatePenalty Decimal?
  adjustment          Decimal? @default(0)
  otherDeduction      Decimal?
  note                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  /// กันส่งซ้ำต่อ event เดียวกัน เช่น feedback-case:{caseId}:{eventType}
  /// partial unique index (userId, type, eventKey) สร้างใน migration เฉพาะแถวที่ไม่ null
  eventKey  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([eventKey])
}

model AttendanceAlertLog {
  id               String   @id @default(cuid())
  date             DateTime
  stationId        String
  shiftId          String
  reportType       String
  status           String   @default("PENDING")
  discordMessageId String?
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([date, stationId, shiftId, reportType])
  @@index([date, status])
}

model SpecialIncome {
  id          String    @id @default(cuid())
  userId      String
  date        DateTime
  shiftId     String?
  stationId   String?
  type        String
  description String?
  salesAmount Decimal?
  percentage  Decimal?
  amount      Decimal
  status      String    @default("PENDING")
  approvedBy  String?
  approvedAt  DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([stationId, date])
  @@index([status])
}

enum Role {
  ADMIN
  HR
  MANAGER
  CASHIER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  RESIGNED
  SUSPENDED
}

enum StationType {
  GAS_STATION
  COFFEE_SHOP
}

enum AttendanceStatus {
  PENDING
  APPROVED
  REJECTED
  ABSENT
  LEAVE
}

enum LeaveType {
  SICK
  PERSONAL
  VACATION
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  FINALIZED
}

enum AdvanceStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShiftPoolStatus {
  OPEN
  CLAIMED
  EXPIRED
  CANCELLED
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  PREFERRED_OFF
}

// Engagement & Feedback
model HappinessLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  mood      String // HAPPY, NEUTRAL, SAD
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model OneOnOneLog {
  id           String   @id @default(cuid())
  userId       String
  supervisorId String
  date         DateTime
  topic        String
  note         String   @db.Text
  actionItems  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User @relation("OneOnOneUser", fields: [userId], references: [id], onDelete: Cascade)
  supervisor User @relation("OneOnOneSupervisor", fields: [supervisorId], references: [id])

  @@index([userId])
  @@index([supervisorId])
}

// Station Transfer — บันทึกการย้ายสาขาระหว่างวัน
model StationTransfer {
  id            String   @id @default(cuid())
  userId        String
  attendanceId  String?
  fromStationId String
  toStationId   String
  transferTime  DateTime
  reason        String?
  method        String   @default("MANAGER") // MANAGER | SELF_QR
  createdBy     String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance  Attendance? @relation(fields: [attendanceId], references: [id])
  fromStation Station     @relation("TransferFrom", fields: [fromStationId], references: [id])
  toStation   Station     @relation("TransferTo", fields: [toStationId], references: [id])

  @@index([userId, transferTime])
  @@index([attendanceId])
}

// Job Application — ใบสมัครงานพนักงานใหม่
model JobApplication {
  id      String            @id @default(cuid())
  refCode String            @unique
  status  ApplicationStatus @default(SUBMITTED)

  // ตำแหน่งที่สมัคร
  positionTitle   String
  employmentType  String?
  stationId       String?
  departmentId    String?
  jobOpeningId    String? // ประกาศรับสมัครที่ผู้สมัครกดสมัครมา (null = สมัครผ่านลิงก์ /apply ตรง)
  expectedSalary  Decimal?
  availableFrom   DateTime?
  preferredShifts Json?

  // ข้อมูลส่วนตัว
  prefix         String?
  firstName      String
  lastName       String
  nickName       String?
  birthDate      DateTime?
  gender         String?
  nationality    String?
  religion       String?
  maritalStatus  String?
  militaryStatus String?
  citizenIdEnc   String?
  citizenIdLast4 String?
  // Deterministic HMAC of the citizen ID, purely so duplicate submissions can be detected —
  // the encrypted value uses a random IV and can't be matched with a query.
  citizenIdHash  String?

  // ติดต่อ
  phone             String
  lineId            String?
  email             String?
  addressRegistered String?
  addressCurrent    String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  // ประวัติ
  educations        Json?
  workExperiences   Json?
  skills            Json?
  hasDrivingLicense Boolean @default(false)
  licenseTypes      String?
  screeningAnswers  Json?
  applicantNote     String?

  // ที่มา
  source           String?
  referredByUserId String?

  // การพิจารณา
  reviewedById  String?
  reviewedAt    DateTime?
  interviewAt   DateTime?
  interviewNote String?
  ratingScore   Int?
  rejectReason  String?
  hiredUserId   String?   @unique
  hiredAt       DateTime?

  // PDPA / audit
  consentAcceptedAt DateTime
  consentVersion    String
  submittedIp       String?
  userAgent         String?
  purgeAfter        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  station    Station?             @relation(fields: [stationId], references: [id])
  department Department?          @relation(fields: [departmentId], references: [id])
  jobOpening JobOpening?          @relation(fields: [jobOpeningId], references: [id])
  reviewedBy User?                @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  hiredUser  User?                @relation("ApplicationHire", fields: [hiredUserId], references: [id])
  files      JobApplicationFile[]

  @@index([status])
  @@index([stationId])
  @@index([createdAt])
  @@index([phone])
  @@index([citizenIdHash])
}

model JobApplicationFile {
  id            String              @id @default(cuid())
  applicationId String?
  kind          ApplicationFileKind
  mimeType      String
  sizeBytes     Int
  width         Int?
  height        Int?
  checksum      String?
  storageDriver String              @default("cloudinary")
  storageKey    String?
  storageMeta   Json?
  data          Bytes?
  createdAt     DateTime            @default(now())
  expiresAt     DateTime?

  application JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([expiresAt])
}

// ประกาศรับสมัครงาน — รายละเอียดตำแหน่งที่ผู้สมัครอ่านก่อนตัดสินใจกรอกใบสมัคร
model JobOpening {
  id                 String    @id @default(cuid())
  slug               String    @unique // ใช้เป็น URL: /jobs/<slug>
  title              String
  description        String    @db.Text
  responsibilities   String?   @db.Text
  requirements       String?   @db.Text
  benefits           String?   @db.Text
  employmentType     String?
  stationId          String?
  departmentId       String?
  salaryMin          Decimal?
  salaryMax          Decimal?
  salaryNote         String? // เช่น "ตามประสบการณ์" กรณีไม่ระบุตัวเลข
  positionsAvailable Int?
  isActive           Boolean   @default(true)
  closesAt           DateTime? // เลยวันนี้แล้วถือว่าปิดรับ
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  station      Station?         @relation(fields: [stationId], references: [id])
  department   Department?      @relation(fields: [departmentId], references: [id])
  createdBy    User             @relation("JobOpeningCreator", fields: [createdById], references: [id])
  applications JobApplication[]

  @@index([isActive])
  @@index([stationId])
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  SCREENING
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum ApplicationFileKind {
  PROFILE_PHOTO
  CITIZEN_ID
  HOUSE_REGISTRATION
  EDUCATION_CERT
  RESUME
  OTHER
}

/// Any image the HR system stores outside a job application — employee photos,
/// the employee document vault, evidence attached to a request, announcement
/// images. Deliberately one flat table rather than one per feature: the bytes,
/// the storage driver and the cleanup rules are identical everywhere, and only
/// `kind` decides who may look at it (see src/lib/assets.ts).
///
/// Written in two phases, same as JobApplicationFile: the row is created first
/// so its id can be the storage key, then storage.put() fills in storageKey.
model StoredAsset {
  id                String    @id @default(cuid())
  kind              AssetKind
  /// The employee this asset is about — the subject, not the uploader. Null only
  /// for assets that belong to no one in particular (announcement images).
  ownerUserId       String?
  uploadedById      String?
  mimeType          String
  sizeBytes         Int
  width             Int?
  height            Int?
  checksum          String?
  fileName          String?
  note              String?
  storageDriver     String    @default("cloudinary")
  storageKey        String?
  storageMeta       Json?
  data              Bytes?
  /// When the *document itself* stops being valid in the real world (work permit,
  /// visa, passport). Drives the expiry reminders — never used for cleanup.
  documentExpiresAt DateTime?
  /// When this row and its bytes should be deleted. Set on upload so an abandoned
  /// upload can't linger; cleared once the asset is attached to something.
  purgeAfter        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  owner      User? @relation("AssetOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("AssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  timeCorrections TimeCorrection[]
  advances        Advance[]
  announcements   Announcement[]

  @@index([ownerUserId, kind])
  @@index([purgeAfter])
  @@index([documentExpiresAt])
}

enum AssetKind {
  /// Employee avatar. At most one live row per employee (enforced in the API,
  /// which deletes the previous one on replace).
  EMPLOYEE_PHOTO

  // ── Employee document vault ────────────────────────────────────────────────
  CITIZEN_ID
  HOUSE_REGISTRATION
  PASSPORT
  WORK_PERMIT
  VISA
  EMPLOYMENT_CONTRACT
  EDUCATION_CERT
  TRAINING_CERT
  BANK_BOOK
  MEDICAL_CERT
  RESUME
  OTHER_DOCUMENT

  // ── Attachments ────────────────────────────────────────────────────────────
  /// Evidence an employee attached to a time-correction or advance request.
  REQUEST_ATTACHMENT
  ANNOUNCEMENT_IMAGE
}

/// ที่พักคนงานของบริษัท พนักงานที่ไม่ได้อยู่ที่นี่จะได้เงินค่าที่พักแทน
/// (ดู docs/employee-housing-design.md)
model Dormitory {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  /// สาขาที่ที่พักนี้รองรับ — ใช้ตรวจว่าพนักงานอยู่ที่พักตรงกับสาขาที่ทำงานไหม
  stationId String?
  capacity  Int?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  station   Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  residents User[]   @relation("EmployeeDormitory")

  @@index([stationId])
}

enum HousingStatus {
  /// ยังไม่ได้สำรวจ — ค่าเริ่มต้น จงใจแยกจาก OWN_HOUSING เพื่อไม่ให้คนที่ยัง
  /// ไม่ได้ถามกลายเป็นคนมีสิทธิ์รับเงินค่าที่พักโดยอัตโนมัติ
  UNKNOWN
  /// อยู่บ้านพักของบริษัท (ต้องระบุ dormitoryId ด้วย)
  COMPANY_DORM
  /// อยู่ที่พักของตัวเอง — เป็นกลุ่มเดียวที่ได้เงินค่าที่พัก
  OWN_HOUSING
}

// ============================================================
// Customer Feedback QR (ระบบประเมินพนักงานและสถานีผ่าน QR)
// แยกจาก Station.qrCode ของระบบลงเวลาทั้งหมด — ดูแผนงาน
// docs/customer-feedback-qr-evaluation-plan.md
// ============================================================

enum FeedbackTargetType {
  EMPLOYEE
  STATION
  UNKNOWN
}

enum FeedbackResponseKind {
  STANDARD
  INCIDENT
}

enum FeedbackVisitKind {
  STANDARD
  INCIDENT
}

enum FeedbackVisitDisposition {
  OPEN
  SUBMITTED
  TARGET_REJECTED
  SWITCHED_TO_INCIDENT
  ABANDONED
  BOT_BLOCKED
  EXPIRED
}

enum FeedbackQrPlacement {
  EMPLOYEE_BADGE
  STATION_MAIN
  CASHIER
  PUMP
  RESTROOM
  SHOP
  OTHER
}

enum FeedbackValidity {
  VALID
  SUSPECTED
  HIDDEN
  TEST
}

enum FeedbackCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum FeedbackCaseSeverity {
  NORMAL
  HIGH
  URGENT
}

enum FeedbackContactChannel {
  PHONE
  EMAIL
}

enum FeedbackDangerStatus {
  YES
  NO
  UNSURE
}

enum FeedbackAnswerState {
  ANSWERED
  SKIPPED
  NOT_SHOWN
}

enum FeedbackReviewRequestStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

/// QR ประเมินลูกค้า — ไม่เกี่ยวกับ Station.qrCode ที่ใช้ลงเวลา
model CustomerFeedbackQr {
  id                        String              @id @default(cuid())
  /// SHA-256 ของ token ใช้ค้นหาตอน resolve
  tokenHash                 String              @unique
  /// token เข้ารหัสไว้เพื่อถอดกลับตอนพิมพ์ซ้ำเท่านั้น
  tokenCiphertext           String
  /// suffix 6 ตัวท้ายสำหรับตรวจป้ายในหน้า admin
  tokenHint                 String
  /// HMAC-SHA-256 ของรหัสกรอกเอง 8 ตัวด้วย server pepper
  manualCodeHash            String              @unique
  manualCodeCiphertext      String
  /// 2 ตัวท้ายของรหัสกรอกเองสำหรับตรวจป้าย
  manualCodeHint            String
  targetType                FeedbackTargetType
  /// มีค่าเมื่อ targetType เป็น EMPLOYEE (check constraint ใน migration)
  employeeId                String?
  /// มีค่าเมื่อ targetType เป็น STATION
  stationId                 String?
  /// ชื่อที่อนุญาตให้แสดงต่อสาธารณะ
  publicLabel               String
  /// ตำแหน่งสาธารณะ เช่น "พนักงานบริการ" — null ได้สำหรับ STATION
  publicPosition            String?
  /// วันที่ HR/ADMIN บันทึกว่าพนักงานรับทราบข้อมูลที่จะแสดง — ต้องมีก่อน activate EMPLOYEE QR
  publicProfileApprovedAt   DateTime?
  publicProfileApprovedById String?
  placement                 FeedbackQrPlacement
  /// เช่น MAIN, CASHIER_01, PUMP_03, EMPLOYEE_PRIMARY
  placementKey              String
  /// ส่วนบริการที่ QR จุดย่อยเลือกไว้ล่วงหน้า
  serviceAreaKey            String?
  isPrimary                 Boolean             @default(false)
  isActive                  Boolean             @default(false)
  /// โหมดทดสอบ — Visit snapshot ค่านี้ตอน resolve และห้ามสลับเมื่อมี Visit แล้ว
  isTest                    Boolean             @default(false)
  /// ต้องพิมพ์ป้ายใหม่ก่อน activate หลังสร้างหรือหมุนรหัส
  needsReprint              Boolean             @default(true)
  version                   Int                 @default(1)
  createdById               String?
  rotatedAt                 DateTime?
  revokedAt                 DateTime?
  lastResolvedAt            DateTime?
  lastPrintedAt             DateTime?
  lastPrintedById           String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  employee                User?                      @relation("FeedbackQrEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  station                 Station?                   @relation(fields: [stationId], references: [id])
  createdBy               User?                      @relation("FeedbackQrCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publicProfileApprovedBy User?                      @relation("FeedbackQrApprovedBy", fields: [publicProfileApprovedById], references: [id], onDelete: SetNull)
  lastPrintedBy           User?                      @relation("FeedbackQrLastPrintedBy", fields: [lastPrintedById], references: [id], onDelete: SetNull)
  visits                  CustomerFeedbackVisit[]
  responses               CustomerFeedbackResponse[]

  @@index([employeeId])
  @@index([stationId])
  @@index([targetType, isActive])
}

/// หนึ่งครั้งที่ลูกค้าเปิดแบบประเมินจาก QR — ใช้คำนวณ funnel และ drop-off
model CustomerFeedbackVisit {
  id                   String                   @id @default(cuid())
  /// null ได้เฉพาะ incident ที่เริ่มก่อน resolve
  qrCodeId             String?
  /// visit เดิมเมื่อผู้ใช้สลับไปแจ้งเหตุ (child INCIDENT หนึ่งตัวต่อ parent)
  parentVisitId        String?                  @unique
  qrVersionAtOpen      Int?
  visitKind            FeedbackVisitKind
  /// employee-v1 | station-v1 | incident-v1
  surveyVersion        String
  disposition          FeedbackVisitDisposition @default(OPEN)
  blockedReason        String?
  isTestAtOpen         Boolean                  @default(false)
  /// hash ของ signed visit token ใช้ตรวจ token ทุกครั้งที่ส่ง
  sessionTokenHash     String               @unique
  /// HMAC ของ network signal เปลี่ยน secret ทุกวัน ไม่เก็บ IP ดิบ
  networkHashDaily     String?
  /// HMAC ของ client signal เปลี่ยน secret ทุกสัปดาห์
  clientHashWeekly     String?
  /// HMAC ของ clientNonce สำหรับ idempotency และ cooldown ของแท็บ
  resolveNonceHash     String?
  hashKeyVersion       String?
  targetType           FeedbackTargetType
  employeeId           String?
  stationIdAtOpen      String?
  stationIdSelected    String?
  /// TOKEN | CURRENT_TRANSFER | CURRENT_ATTENDANCE | USER_STATION | CUSTOMER_SELECTED | UNKNOWN
  stationContextSource String
  departmentIdAtOpen   String?
  shiftIdAtOpen        String?
  deviceClass          String?
  language             String                   @default("th")
  variantKey           String?
  optionOrder          Json?
  /// YES | NO | UNSURE
  targetConfirmation   String?
  openedAt             DateTime                 @default(now())
  startedAt            DateTime?
  submittedAt          DateTime?
  lastStep             String?
  formExpiresAt        DateTime
  /// ลบ Visit หลังทำ aggregate ตาม retention
  purgeAfter           DateTime

  qrCode      CustomerFeedbackQr?        @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  parentVisit CustomerFeedbackVisit?     @relation("VisitParent", fields: [parentVisitId], references: [id], onDelete: SetNull)
  children    CustomerFeedbackVisit[]    @relation("VisitParent")
  responses   CustomerFeedbackResponse[]

  @@index([qrCodeId])
  @@index([parentVisitId])
  @@index([disposition])
  @@index([openedAt])
  @@unique([resolveNonceHash, qrCodeId, visitKind])
}

model CustomerFeedbackResponse {
  id                      String                @id @default(cuid())
  refCode                 String                @unique
  visitId                 String?               @unique
  qrCodeId                String?
  qrVersionAtSubmit       Int?
  kind                    FeedbackResponseKind
  targetType              FeedbackTargetType
  employeeId              String?
  stationId               String?
  departmentIdAtSubmit    String?
  shiftIdAtSubmit         String?
  departmentLabelSnapshot String?
  shiftLabelSnapshot      String?
  stationContextSource    String
  employeeLabelSnapshot   String?
  stationLabelSnapshot    String?
  surveyVersion           String
  privacyNoticeVersion    String
  language                String                @default("th")
  serviceAreas            String[]
  overallRating           Int?
  reasonKeys              String[]
  incidentKey             String?
  dangerStatus            FeedbackDangerStatus?
  occurredAt              DateTime?
  noDetail                Boolean               @default(false)
  comment                 String?
  wantsFollowUp           Boolean               @default(false)
  validity                FeedbackValidity      @default(VALID)
  abuseScore              Int                   @default(0)
  abuseReasons            String[]
  idempotencyKeyHash      String                @unique
  idempotencyPayloadHash  String
  durationSeconds         Int
  reportDate              DateTime              @db.Date
  submittedAt             DateTime
  createdAt               DateTime              @default(now())

  visit    CustomerFeedbackVisit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  qrCode   CustomerFeedbackQr?      @relation(fields: [qrCodeId], references: [id])
  employee User?                    @relation("FeedbackResponseEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  station  Station?                 @relation("FeedbackStationResponse", fields: [stationId], references: [id])
  contact  CustomerFeedbackContact?
  answers  CustomerFeedbackAnswer[]
  case     CustomerFeedbackCase?

  @@index([stationId, submittedAt])
  @@index([employeeId, submittedAt])
  @@index([overallRating, submittedAt])
  @@index([validity, submittedAt])
  @@index([reportDate, validity])
  @@index([kind, submittedAt])
}

/// ข้อมูลติดต่อกลับ — แยกจากคำตอบทั่วไปและเข้ารหัสทุกฟิลด์
model CustomerFeedbackContact {
  id             String                 @id @default(cuid())
  responseId     String                 @unique
  channel        FeedbackContactChannel
  nameEncrypted  String?
  valueEncrypted String
  preferredTime  String?
  consentAt      DateTime
  /// createdAt + 120 วัน ลดได้ตามวันปิดเคส แต่ห้ามขยาย
  purgeAfter     DateTime
  createdAt      DateTime               @default(now())

  response CustomerFeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([purgeAfter])
}

model CustomerFeedbackCase {
  id              String               @id @default(cuid())
  responseId      String               @unique
  /// null ได้ก่อน ADMIN/HR ระบุสถานี — เคสแบบนั้นแสดงเฉพาะ ADMIN และ HR
  stationId       String?
  severity        FeedbackCaseSeverity
  /// incident key หรือ follow-up
  category        String
  status          FeedbackCaseStatus   @default(OPEN)
  assignedToId    String?
  dueAt           DateTime
  acknowledgedAt  DateTime?
  resolutionNote  String?
  dismissedReason String?
  resolvedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  response   CustomerFeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  assignedTo User?                    @relation("FeedbackCaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, severity])
  @@index([stationId])
  @@index([assignedToId])
  @@index([dueAt])
}

/// คำตอบแบบ normalized แยก ANSWERED / SKIPPED / NOT_SHOWN ตาม branching
model CustomerFeedbackAnswer {
  id            String              @id @default(cuid())
  responseId    String
  surveyVersion String
  questionKey   String
  state         FeedbackAnswerState
  numberValue   Int?
  textValue     String?
  choiceValues  String[]

  response CustomerFeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionKey])
  @@index([questionKey])
}

/// persistent rate limit เมื่อยังไม่มี Redis — atomic increment
model CustomerFeedbackRateBucket {
  id          String   @id @default(cuid())
  action      String
  keyHash     String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@unique([action, keyHash, windowStart])
  @@index([expiresAt])
}

/// alert ที่ส่งแล้ว กันส่งซ้ำภายใน window เดียวกัน
model CustomerFeedbackAlertLog {
  id          String             @id @default(cuid())
  ruleCode    String
  ruleVersion Int                @default(1)
  targetType  FeedbackTargetType
  /// กฎระดับทั้งระบบใช้ GLOBAL ห้าม null
  targetId    String
  windowStart DateTime
  windowEnd   DateTime
  status      String             @default("SENT")
  notifiedAt  DateTime           @default(now())
  resolvedAt  DateTime?
  details     Json?

  @@unique([ruleCode, ruleVersion, targetId, windowStart])
  @@index([targetId, ruleCode])
}

/// funnel aggregate ต่อวัน — ข้อมูลถาวรหลังลบ Visit
model CustomerFeedbackDailyAggregate {
  id                    String             @id @default(cuid())
  reportDate            DateTime           @db.Date
  stationKey            String
  targetType            FeedbackTargetType
  placementKey          String
  language              String
  surveyVersion         String
  isTest                Boolean
  openedCount           Int                @default(0)
  startedCount          Int                @default(0)
  confirmedCount        Int                @default(0)
  targetRejectedCount   Int                @default(0)
  submittedCount        Int                @default(0)
  switchedIncidentCount Int                @default(0)
  abandonedCount        Int                @default(0)
  botBlockedCount       Int                @default(0)
  expiredCount          Int                @default(0)
  validCount            Int                @default(0)
  suspectedCount        Int                @default(0)
  ratingSum             Int                @default(0)
  ratingCount           Int                @default(0)
  rating1Count          Int                @default(0)
  rating2Count          Int                @default(0)
  rating3Count          Int                @default(0)
  rating4Count          Int                @default(0)
  rating5Count          Int                @default(0)

  @@unique([reportDate, stationKey, targetType, placementKey, language, surveyVersion, isTest])
  @@index([reportDate])
}

/// ผล resolve ที่เกิดก่อนรู้ QR — แยกจาก funnel ของ Visit
model CustomerFeedbackResolveDailyAggregate {
  id           String   @id @default(cuid())
  reportDate   DateTime @db.Date
  /// TOKEN | MANUAL_CODE | STANDALONE_INCIDENT
  resolverType String
  /// SUCCESS | INVALID | INACTIVE | RATE_LIMITED
  result       String
  count        Int      @default(0)

  @@unique([reportDate, resolverType, result])
}

/// แนวโน้ม reason key หลังลบ Response รายรายการ
model CustomerFeedbackDailyReasonAggregate {
  id             String             @id @default(cuid())
  reportDate     DateTime           @db.Date
  stationKey     String
  targetType     FeedbackTargetType
  reasonKey      String
  surveyVersion  String
  isTest         Boolean
  validCount     Int                @default(0)
  suspectedCount Int                @default(0)

  @@unique([reportDate, stationKey, targetType, reasonKey, surveyVersion, isTest])
  @@index([reportDate])
}

/// หลักฐานสรุปเมื่อปิด ReviewPeriod — ไม่เก็บ comment ดิบ
model CustomerFeedbackReviewSnapshot {
  id                     String   @id @default(cuid())
  reviewPeriodId         String
  employeeId             String?
  employeeLabelSnapshot  String
  dateFrom               DateTime
  dateTo                 DateTime
  validCount             Int
  ratingAverage          Decimal  @db.Decimal(4, 2)
  positiveRate           Decimal  @db.Decimal(5, 2)
  negativeRate           Decimal  @db.Decimal(5, 2)
  suspectedExcludedCount Int      @default(0)
  topReasonKeys          String[]
  generatedAt            DateTime @default(now())
  generatedById          String?

  reviewPeriod ReviewPeriod @relation(fields: [reviewPeriodId], references: [id])
  employee     User?        @relation("ReviewSnapshotEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  generatedBy  User?        @relation("ReviewSnapshotGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([reviewPeriodId, employeeId])
}

/// คำขอทบทวนของพนักงานเมื่อสงสัยว่าคำตอบไม่เป็นธรรม
model CustomerFeedbackReviewRequest {
  id                    String                      @id @default(cuid())
  employeeId            String?
  employeeLabelSnapshot String
  reviewPeriodId        String?
  /// ReviewPeriod.id หรือ GENERAL
  scopeKey              String
  reason                String                      @db.VarChar(500)
  status                FeedbackReviewRequestStatus @default(OPEN)
  reviewedById          String?
  resolutionNote        String?
  submittedAt           DateTime                    @default(now())
  resolvedAt            DateTime?
  updatedAt             DateTime                    @updatedAt

  employee   User? @relation("ReviewRequestEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("ReviewRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([employeeId, status])
}

/// จำนวน request เพื่อ health alert โดยไม่เก็บตัวระบุผู้ใช้
model CustomerFeedbackOperationalMetricBucket {
  id          String   @id @default(cuid())
  minuteStart DateTime
  metricCode  String
  /// SUCCESS | CLIENT_ERROR | SERVER_ERROR | RATE_LIMITED
  outcome     String
  statusClass Int
  count       Int      @default(0)

  @@unique([minuteStart, metricCode, outcome, statusClass])
  @@index([minuteStart])
}
